# Copia este archivo a .env.local y pon UNA sola credencial.
# .env.local está en .gitignore: la key nunca entra al repo.
#
#   cp .env.example .env.local
#
# Se usa la primera que exista, en este orden:

# 1) Vercel AI Gateway — recomendado: una key, cualquier modelo.
#    https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# 2) Claude directo
# ANTHROPIC_API_KEY=

# 3) GPT directo
# OPENAI_API_KEY=

# 4) Gemini directo
# GOOGLE_GENERATIVE_AI_API_KEY=

# Opcional: forzar el id del modelo.
#   con gateway  → anthropic/claude-sonnet-5
#   con Anthropic→ claude-sonnet-4-5
# LOGIA_MODEL=
